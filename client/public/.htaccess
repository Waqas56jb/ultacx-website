# Apache / cPanel SPA fallback (covers most shared hosting, incl. Zoho-style setups).
# Serve real files and directories as-is; send everything else to index.html so
# React Router can resolve the route on a refresh or a direct link.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite requests that map to a real file or directory
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> the SPA shell
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed asset filenames are content-addressed, so cache them hard
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The shell must always revalidate or users get a stale app
  <FilesMatch "index\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
